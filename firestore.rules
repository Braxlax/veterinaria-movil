rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    match /usuarios/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.rol == 'cliente';
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.rol == resource.data.rol;
      allow delete: if isAdmin();
    }

    match /mascotas/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow create, update: if signedIn() && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);
      allow delete: if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
    }

    match /citas/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow create, update: if signedIn() && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);
      allow delete: if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
    }

    match /solicitudes/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow create, update: if signedIn() && (isAdmin() || request.resource.data.ownerUid == request.auth.uid);
      allow delete: if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
    }
  }
}
